menu "ScanIt controlled Wi-Fi sounding"

config SCANIT_SOUNDING_CHANNEL
    int "5 GHz Wi-Fi channel"
    range 36 177
    default 36

config SCANIT_SOUNDING_RATE_HZ
    int "Sounding rate (Hz)"
    range 1 100
    default 20

config SCANIT_SOUNDING_SESSION_NONCE
    hex "Session nonce"
    default 0x5343414E
    help
        Static development nonce. Production runs should supply a fresh session
        nonce from the gateway before capture.

endmenu
